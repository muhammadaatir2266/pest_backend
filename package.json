{
  "name": "pest-detection-backend",
  "version": "1.0.0",
  "description": "Node.js REST API Backend for Farmers Pest Detection Application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "railway:start": "npx prisma db push && node prisma/seed.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npx prisma generate",
    "postinstall": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "pest-detection",
    "agriculture",
    "express",
    "prisma",
    "postgresql",
    "huggingface"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/inference": "^2.8.1",
    "@prisma/client": "^5.10.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2",
    "supertest": "^6.3.4"
  }
}
