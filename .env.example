PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Railway Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pest_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET=super_secret_farmers_pest_jwt_key_2026
JWT_REFRESH_SECRET=super_secret_refresh_token_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Hugging Face AI Vision Model API Key (Optional: model will fall back gracefully if empty)
HUGGINGFACE_API_KEY=hf_example_token_key
HUGGINGFACE_MODEL=underdogquality/yolo11s-pest-detection

# S3 Compatible Cloud Storage (Railway StorageAPI / Tigris / AWS S3 / Cloudflare R2)
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_URL=https://t3.storageapi.dev/your_bucket_name

# Cloud Image Storage (Cloudinary - Alternative Cloud Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
