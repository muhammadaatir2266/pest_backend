{
  "openapi": "3.0.0",
  "info": {
    "title": "Farmers Pest Detection REST API",
    "version": "1.0.0",
    "description": "API documentation for Farmers Pest Identification & Crop Solution Application with Hugging Face ML Vision integration."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Register a new farmer user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Ahmad Khan" },
                  "email": { "type": "string", "example": "ahmad@example.com" },
                  "phone": { "type": "string", "example": "+923001234567" },
                  "password": { "type": "string", "example": "farmer123" },
                  "farmLocation": { "type": "string", "example": "Multan, Punjab" },
                  "preferredLanguage": { "type": "string", "enum": ["en", "ur"], "example": "en" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login with email/phone and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "loginIdentifier": { "type": "string", "example": "ahmad@example.com" },
                  "password": { "type": "string", "example": "farmer123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" }
        }
      }
    },
    "/scans": {
      "post": {
        "summary": "Analyze pest photo using Hugging Face Vision Model",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pest identified with pesticides & crop impact" }
        }
      },
      "get": {
        "summary": "Get user scan history",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Scan history list" }
        }
      }
    }
  }
}
